            directionB = random.choice(['bLeft', 'bRight', 'back'])
            """ valBackRight = math.sqrt((abs(pygame.mouse.get_pos()[0] - (x+1))^2) + ((abs(pygame.mouse.get_pos()[1] - (y+1))^2)))
                    valBAckLeft = math.sqrt((abs(pygame.mouse.get_pos()[0] - (x+2))^2) + ((abs(pygame.mouse.get_pos()[1] - y)^2)))
                    valBack = math.sqrt((abs(pygame.mouse.get_pos()[0] - (x+1))^2) + ((abs(pygame.mouse.get_pos()[1] - (y-1))^2))) """
            """ if valBackRight > valBAckLeft or valBack:
                         return "bRight"
                    elif valBAckLeft > valBack:
